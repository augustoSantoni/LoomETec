    {
        "id": "process_wifi",
        "type": "function",
        "z": "tab_principal",
        "name": "Procesar WiFi",
        "func": "if (!msg.payload.ssid || !msg.payload.password) {\n    msg.payload = {error: 'Faltan campos'};\n    msg.statusCode = 400;\n    return [msg, null];\n}\nmsg.topic = 'config/red';\nmsg.payload = {ssid: msg.payload.ssid, password: msg.payload.password};\nreturn [null, msg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 440,
        "wires": [
            [
                "mqtt_config_red"
            ],
            [
                "http_response_error"
            ]
        ]
    },
