    {
        "id": "http_patron",
        "type": "http in",
        "z": "tab_principal",
        "name": "API Patrón",
        "url": "/api/config/patron",
        "method": "post",
        "upload": true,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 140,
        "y": 500,
        "wires": [
            [
                "process_patron"
            ]
        ]
    },
    {
        "id": "process_patron",
        "type": "function",
        "z": "tab_principal",
        "name": "Procesar JSON subido",
        "func": "const file = msg.req.files?.patron?.[0] || msg.req.files?.[0];\nif (!file) {\n    msg.payload = {error: 'No se recibió archivo'};\n    msg.statusCode = 400;\n    return [msg, null];\n}\nif (file.mimetype !== 'application/json') {\n    msg.payload = {error: 'Solo archivos JSON permitidos'};\n    msg.statusCode = 400;\n    return [msg, null];\n}\nlet content;\ntry {\n    content = file.buffer.toString('utf8');\n    JSON.parse(content);\n} catch(e) {\n    msg.payload = {error: 'JSON inválido: ' + e.message};\n    msg.statusCode = 400;\n    return [msg, null];\n}\nmsg.topic = 'config/patron';\nmsg.payload = {\n    filename: file.originalname,\n    content: content\n};\nreturn [null, msg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 540,
        "wires": [
            [
                "mqtt_config_patron"
            ],
            [
                "http_response_error"
            ]
        ]
    },
